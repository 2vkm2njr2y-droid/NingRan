<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>6.1.16</Version>
    <AssemblyVersion>6.1.16.0</AssemblyVersion>
    <FileVersion>6.1.16.0</FileVersion>
    <InformationalVersion>6.1.16</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SetupFlavor)' == 'MediaPlayer'">
    <DefineConstants>$(DefineConstants);NINGRAN_MEDIA_PLAYER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NingRan.Core.Tests" />
  </ItemGroup>

</Project>
