<Window x:Class="NingRan.Windows.MediaPlayerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="播放器设置" Width="600" Height="430" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="播放器设置" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="选择加密文件和安全交付包中音频、视频的打开方式。"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="NingRanPlayerRadio" GroupName="PlayerChoice"
                             Content="凝然播放器（推荐）" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="使用单独安装的凝然播放器。未安装或连接失败时，会自动改用内置播放器。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="25,7,0,0" />
                <TextBlock x:Name="ExternalPlayerStatusText" Foreground="{StaticResource PrimaryBrush}"
                           FontSize="12" Margin="25,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel>
                <RadioButton x:Name="BuiltInPlayerRadio" GroupName="PlayerChoice"
                             Content="内置播放器" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="直接在凝然加密窗口中播放。"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="25,7,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="严格防护开启时会临时强制使用内置播放器；关闭后仍会恢复您保存的选择。"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,12"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="SaveChoiceButton" Content="保存选择" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="SaveChoice_Click" />
        </StackPanel>
    </Grid>
</Window>
