<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NingRan.Core\NingRan.Core.csproj" />
    <ProjectReference Include="..\NingRan.StrictMonitor\NingRan.StrictMonitor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NingRan.DeliveryChecks" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SecureWebView2Policy.cs" Link="SecureWebView2Policy.cs" />
    <Compile Include="..\Shared\NativeElevationBinding.cs" Link="NativeElevationBinding.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="winfsp.net" Version="2.2.26215" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NingRan</AssemblyName>
    <RootNamespace>NingRan.Windows</RootNamespace>
    <Version>10.0.1</Version>
    <AssemblyVersion>10.0.1.0</AssemblyVersion>
    <FileVersion>10.0.1.0</FileVersion>
    <InformationalVersion>10.0.1</InformationalVersion>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\EncryptedFileIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\IdentityBackupIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\PublicIdentityIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyStrictProtectionMonitor" AfterTargets="Build;Publish"
          Condition="'$(SkipBundledHelperCopy)' != 'true'">
    <ItemGroup>
      <StrictMonitorFiles Include="$(MSBuildProjectDirectory)\..\NingRan.StrictMonitor\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\NingRan.StrictMonitor.*" />
    </ItemGroup>
    <Copy SourceFiles="@(StrictMonitorFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StrictMonitorFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
