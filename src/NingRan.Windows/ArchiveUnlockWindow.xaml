<Window x:Class="NingRan.Windows.ArchiveUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择解锁方式" Width="980" MinWidth="980" MinHeight="430"
        SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <Style x:Key="UnlockChoice" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#FFFFFF" BorderBrush="#D9E2F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="12" BorderBrush="#8EA4BA" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,10,0">
                                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#117A63" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#117A63" />
                                <Setter TargetName="Card" Property="Background" Value="#EFFAF6" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F4F8FC" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.52" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4DEE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#243247" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" BasedOn="{StaticResource RoundButton}" TargetType="Button">
            <Setter Property="Background" Value="#117A63" />
            <Setter Property="BorderBrush" Value="#117A63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Border Margin="10" Background="#F5F7FA" BorderBrush="#DCE4E9" BorderThickness="1" CornerRadius="12">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.25" Color="#172033" /></Border.Effect>
        <Grid Margin="26,0,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="-26,0,-26,0" Background="#EEF3F8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" Background="#117A63" CornerRadius="12" Margin="16,0,10,0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="White" Data="M4,7 L4,5 C4,2.8 5.8,1 8,1 C10.2,1 12,2.8 12,5 L12,7 L14,7 L14,15 L2,15 L2,7 Z M6,7 L10,7 L10,5 C10,3.9 9.1,3 8,3 C6.9,3 6,3.9 6,5 Z M8,9 C7.4,9 7,9.4 7,10 C7,10.4 7.2,10.8 7.6,11 L7.6,13 L8.4,13 L8.4,11 C8.8,10.8 9,10.4 9,10 C9,9.4 8.6,9 8,9 Z" />
                </Border>
                <TextBlock Grid.Column="1" Text="选择解锁方式" VerticalAlignment="Center" FontSize="14" Foreground="#243247" />
                <Button Grid.Column="2" Content="×" Width="48" Height="50" Padding="0" BorderThickness="0" Background="Transparent" FontSize="25" Foreground="#243247" Click="CloseWindow_Click" ToolTip="关闭" />
            </Grid>
            <TextBlock x:Name="TitleText" Grid.Row="1" Text="选择解锁方式" FontSize="27" FontWeight="SemiBold" Foreground="#111827" Margin="0,24,0,0" />
            <TextBlock x:Name="SubtitleText" Grid.Row="2" Margin="0,6,0,17" Foreground="#667085" TextWrapping="Wrap" FontSize="13" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <RadioButton x:Name="StandardChoice" Grid.Column="0" GroupName="UnlockMode" IsChecked="True" Style="{StaticResource UnlockChoice}" Checked="Mode_Checked">
                    <StackPanel><TextBlock x:Name="StandardTitle" Text="密码" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="StandardDescription" Text="使用创建文件时设置的密码。" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="KeyChoice" Grid.Column="1" GroupName="UnlockMode" Style="{StaticResource UnlockChoice}" Checked="Mode_Checked">
                    <StackPanel><TextBlock x:Name="KeyTitle" Text="密码 + 密匙文件" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="KeyDescription" Text="同时选择创建时使用的密匙文件。" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="PhysicalChoice" Grid.Column="2" GroupName="UnlockMode" Style="{StaticResource UnlockChoice}" Checked="Mode_Checked">
                    <StackPanel><TextBlock x:Name="PhysicalTitle" Text="密码 + 物理设备" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="PhysicalDescription" Text="插入已经授权的物理设备后继续。" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="FlexibleChoice" Grid.Column="3" GroupName="UnlockMode" Style="{StaticResource UnlockChoice}" Margin="0" Checked="Mode_Checked">
                    <StackPanel><TextBlock x:Name="FlexibleTitle" Text="自定义组合保护" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="FlexibleDescription" Text="按文件中记录的保护条件解锁。" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </RadioButton>
            </Grid>
            <Border x:Name="FlexiblePanel" Grid.Row="4" Visibility="Collapsed" Background="#F0F8F5" BorderBrush="#B8DECF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="文件要求的条件" FontWeight="SemiBold" /><TextBlock x:Name="FlexibleRequirementText" Margin="10,0,0,0" Foreground="#117A63" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="勾选项由文件头自动识别" Foreground="#667085" FontSize="11" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="FlexiblePasswordCheck" Content="密码" Margin="0,0,20,0" IsEnabled="False" />
                        <CheckBox x:Name="FlexibleKeyFileCheck" Content="密匙文件" Margin="0,0,20,0" IsEnabled="False" />
                        <CheckBox x:Name="FlexiblePhysicalCheck" Content="物理设备" Margin="0,0,20,0" IsEnabled="False" />
                        <CheckBox x:Name="FlexibleHelloCheck" Content="Windows Hello" IsEnabled="False" />
                    </WrapPanel>
                    <TextBlock x:Name="FlexibleHintText" Text="每个显示为必需的条件都需要通过验证；物理设备和 Windows Hello 会在继续后由原有流程验证。" Foreground="#667085" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Grid x:Name="InputPanel" Grid.Row="5" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,16,0">
                    <TextBlock x:Name="KeyLabel" Text="密匙文件" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="KeyFileInput" IsReadOnly="True" Padding="9,7" /><Button x:Name="ChooseKeyButton" Grid.Column="1" Content="选择" Style="{StaticResource RoundButton}" Click="ChooseKey_Click" Margin="8,0,0,0" /></Grid>
                </StackPanel>
                <StackPanel Grid.Column="1"><TextBlock x:Name="PasswordLabel" Text="密码" FontWeight="SemiBold" Margin="0,0,0,6" /><PasswordBox x:Name="PasswordInput" Padding="9,7" /></StackPanel>
                <StackPanel x:Name="PhysicalPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,13,0,0"><TextBlock x:Name="PhysicalHint" Text="请插入加密时授权的物理设备。设备名称和编号会在成功解锁前保持隐藏。" Foreground="#667085" TextWrapping="Wrap" /></StackPanel>
            </Grid>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource RoundButton}" Click="Cancel_Click" />
                <Button x:Name="UnlockButton" Content="解锁并打开" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Unlock_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
