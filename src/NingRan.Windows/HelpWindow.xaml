<Window x:Class="NingRan.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HelpRoot" Title="凝然加密帮助文档" Icon="Assets/AppIcon.ico"
        Width="1260" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="6,2,6,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DocumentTitle" Text="凝然加密帮助文档" FontSize="25" FontWeight="SemiBold" />
                <TextBlock x:Name="DocumentSubtitle"
                           Text="按功能查找详细说明、操作步骤和安全边界。"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchLabel" Text="搜索" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" MinHeight="34" Padding="10,6"
                         ToolTip="按功能名称、按钮或关键词搜索" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                        <TextBlock x:Name="NavigationHint" Text="点击功能名称查看详细说明。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock x:Name="SearchResultText" Foreground="{StaticResource PrimaryBrush}"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                    <TreeView x:Name="HelpTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="HelpTree_SelectedItemChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="DocumentScroll" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,30,38,34">
                            <TextBlock x:Name="DocumentCategory" Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="TopicTitle" Text="开始使用"
                                       FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="TopicLead" TextWrapping="Wrap" LineHeight="24"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,10,0,22" />
                            <Separator Margin="0,0,0,20" />
                            <StackPanel x:Name="DocumentBody" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="22,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousButton" Content="上一项" Padding="14,7"
                                    Click="PreviousButton_Click" />
                            <TextBlock x:Name="TopicPosition" Grid.Column="1" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <Button x:Name="NextButton" Grid.Column="2" Content="下一项"
                                    Padding="14,7" Click="NextButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
