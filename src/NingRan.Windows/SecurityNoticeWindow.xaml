<Window x:Class="NingRan.Windows.SecurityNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凝然加密 - 安全提醒" Width="600" Height="410"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="Transparent" ShowInTaskbar="True">
    <Border Margin="14" CornerRadius="22" Background="{StaticResource CardBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.22" Color="#245B49" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Border Background="#168565" CornerRadius="22,22,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock Text="凝" Width="34" FontSize="22" FontWeight="Bold" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="凝然加密 · 安全提醒" Foreground="White" FontSize="15"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="52" Height="52" MinHeight="0" Padding="0"
                            Content="×" FontSize="22" Foreground="White" BorderThickness="0"
                            Background="Transparent" Click="ExitButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="40,30,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" CornerRadius="36" Background="#E1F2EB"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock Text="!" Foreground="{StaticResource PrimaryBrush}" FontSize="38"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="已停止高权限启动" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Margin="0,13,0,0" TextWrapping="Wrap" LineHeight="24"
                               Foreground="{StaticResource MutedBrush}" FontSize="14">
                        为了避免高权限误删或改动文件，凝然加密不能以管理员身份运行。
                        <LineBreak /><LineBreak />
                        请安全退出，然后直接双击程序或快捷方式重新打开，不要选择“以管理员身份运行”。
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="#F8FBFA" CornerRadius="0,0,22,22">
                <Button Content="安全退出" Style="{StaticResource PrimaryButton}" Width="126"
                        HorizontalAlignment="Right" Margin="0,16,28,16" Click="ExitButton_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
