<Window x:Class="NingRan.Windows.VaultEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凝然保险箱" Width="720" Height="430" MinWidth="640" MinHeight="390"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="凝然保险箱" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" Text="请选择这次要做的事情。创建和打开使用各自独立的界面。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="CreateTitleText" Text="创建保险箱" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="CreateDescriptionText"
                               Text="设置保存位置、容量和密码，也可以建立使用第二套密码的独立空间。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button x:Name="CreateVaultButton" Content="开始创建" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Click="CreateVault_Click" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="OpenTitleText" Text="打开保险箱" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="OpenDescriptionText"
                               Text="选择已有保险箱，输入对应密码，然后挂载为临时磁盘并自动打开。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button x:Name="OpenVaultButton" Content="开始打开" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Click="OpenVault_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="HintText" Grid.Row="2"
                   Text="挂载失败时才会提供软件内查看作为备用方式。"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" />
    </Grid>
</Window>
