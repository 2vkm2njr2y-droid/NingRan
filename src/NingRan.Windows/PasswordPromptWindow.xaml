<Window x:Class="NingRan.Windows.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入密码" Width="440" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="请输入密码" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ProtectionLabel" Text="加密包保护方式" Margin="0,0,0,5" />
            <ComboBox x:Name="ProtectionModeCombo" SelectedIndex="0" SelectionChanged="ProtectionModeCombo_SelectionChanged">
                <ComboBoxItem Content="密码" />
                <ComboBoxItem Content="密码＋密匙文件" />
                <ComboBoxItem Content="密码＋物理设备" />
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="KeyFilePanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="KeyFileLabel" Text="密匙文件" Margin="0,0,0,5" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="KeyFileInput" IsReadOnly="True" />
                <Button x:Name="ChooseKeyButton" Grid.Column="1" Content="选择" Click="ChooseKey_Click" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,10,0,14">
            <TextBlock x:Name="PasswordLabel" Text="密码" Margin="0,0,0,5" />
            <PasswordBox x:Name="PasswordInput" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
