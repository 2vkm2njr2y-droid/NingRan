<Window x:Class="NingRan.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="290"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Border Margin="20" CornerRadius="22" Background="#FCFEFD" BorderBrush="#CFE2DA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.22" Color="#17352C" />
        </Border.Effect>
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#E5F4EE">
                    <Image Source="Assets/AppIcon.png" Width="31" Height="31" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="正在处理" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="请不要关闭电脑或移动正在处理的文件"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="CurrentItemText" Grid.Row="1" Text="正在准备…" Margin="0,21,0,8"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="12" Minimum="0" Maximum="100"
                         Foreground="{StaticResource PrimaryBrush}" Background="#E4EEE9" Value="0" />

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RemainingText" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Foreground="{StaticResource PrimaryBrush}"
                           FontWeight="SemiBold" />
            </Grid>

            <Button x:Name="CancelButton" Grid.Row="4" Content="取消" Click="CancelButton_Click"
                    HorizontalAlignment="Right" MinWidth="92" Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>
