<Window x:Class="NingRan.Windows.VaultExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出保险箱" Width="480" Height="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="导出为 .nrenc" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="HintText" Text="导出的加密包使用独立密码，并由您选择的发送者身份签名。"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock x:Name="IdentityLabel" Text="发送者身份" Margin="0,0,0,5" />
            <ComboBox x:Name="IdentityCombo" DisplayMemberPath="DisplayText" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ArchivePasswordLabel" Text="加密包密码" Margin="0,0,0,5" />
            <PasswordBox x:Name="ArchivePasswordInput" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ConfirmPasswordLabel" Text="再次输入加密包密码" Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmPasswordInput" />
            <TextBlock x:Name="IdentityPasswordLabel" Text="发送者身份密码" Margin="0,12,0,5" />
            <PasswordBox x:Name="IdentityPasswordInput" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button x:Name="ExportButton" Content="开始导出" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Export_Click" />
        </StackPanel>
    </Grid>
</Window>
