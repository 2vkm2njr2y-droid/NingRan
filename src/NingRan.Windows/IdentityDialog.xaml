<Window x:Class="NingRan.Windows.IdentityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送者身份" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="创建发送者身份" FontSize="19" FontWeight="Bold" />
            <TextBlock x:Name="DescriptionText" Margin="0,6,0,18" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="身份用于证明加密文件由谁制作。私密身份会加密保存在本机。" />

            <StackPanel x:Name="NamePanel">
                <TextBlock Text="身份名称" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="IdentityNameInput" MaxLength="80" />
                <TextBlock Text="例如姓名、昵称或组织名称，由您自行填写。" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13" />
            </StackPanel>

            <TextBlock Text="身份密码" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="IdentityPasswordInput" />
            <TextBlock x:Name="PasswordHintText" Text="建议使用至少 16 个字符的口令短语；较弱密码会提示，但可自行决定继续。" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13" />

            <StackPanel x:Name="ConfirmPanel">
                <TextBlock Text="再次输入身份密码" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox x:Name="ConfirmIdentityPasswordInput" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="创建身份" Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
