<Window x:Class="NingRan.Windows.ArchiveModificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认修改加密文件" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA" ShowInTaskbar="False">
    <Border Margin="18" Padding="24" Background="White" BorderBrush="#DCE4E9" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="确认修改加密文件" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock x:Name="HintText" Grid.Row="1" Text="追加或删除会生成新的加密内容。原文件只有在新内容验证成功后才会替换。" TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,18" />

            <TextBlock x:Name="ArchivePasswordLabel" Grid.Row="2" Text="原加密文件密码" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="ArchivePasswordInput" Grid.Row="3" Padding="9,7" />

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="IdentityLabel" Text="修改后使用的发送者身份" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="IdentityCombo" DisplayMemberPath="DisplayText" MinHeight="34" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock x:Name="IdentityPasswordLabel" Text="身份密码" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <PasswordBox x:Name="IdentityPasswordInput" Padding="9,7" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#B54708" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="取消" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="确认并继续" Padding="14,7" Background="#117A63" Foreground="White" BorderBrush="#117A63" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
