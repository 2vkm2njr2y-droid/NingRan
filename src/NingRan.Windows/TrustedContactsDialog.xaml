<Window x:Class="NingRan.Windows.TrustedContactsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理可信联系人" Width="720" Height="520"
        MinWidth="620" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="可信发送者联系人" FontSize="19" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="这里只保存您已经通过另一种可信方式核对过的公开身份。删除联系人不会删除任何加密文件。" />
        </StackPanel>

        <ListBox x:Name="ContactList" Grid.Row="1" DisplayMemberPath="DisplayText"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 SelectionChanged="ContactList_SelectionChanged" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ContactDetails" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" Text="请选择一个联系人查看确认时间。" />
            <Button x:Name="RemoveButton" Grid.Column="1" Content="删除所选联系人"
                    IsEnabled="False" Click="Remove_Click" Margin="10,0,8,0" />
            <Button Grid.Column="2" Content="关闭" Style="{StaticResource PrimaryButton}"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
