<Window x:Class="NingRan.Windows.AppendFilePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要追加的文件"
        Width="920" Height="620" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F7F9F8" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F2EE" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F2EE" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF6F3" />
                    <Setter Property="BorderBrush" Value="#D5E8E0" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEFE8" />
                    <Setter Property="BorderBrush" Value="#8DCBB5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D8E5E0" BorderThickness="0,0,0,1">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="&#xE72B;"
                            ToolTip="后退" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Content="&#xE72A;"
                            ToolTip="前进" Click="Forward_Click" />
                    <Button x:Name="UpButton" Style="{StaticResource ToolbarButton}" Content="&#xE74A;"
                            ToolTip="上一级" Click="Up_Click" />
                </StackPanel>

                <Border Grid.Column="1" Background="#F8FAF9" BorderBrush="#CBDDD6" BorderThickness="1"
                        CornerRadius="5" Margin="6,0,10,0">
                    <TextBox x:Name="AddressInput" BorderThickness="0" Background="Transparent"
                             MinHeight="34" Padding="10,5" KeyDown="AddressInput_KeyDown" />
                </Border>

                <Border Grid.Column="2" Background="#F8FAF9" BorderBrush="#CBDDD6" BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#61766F" />
                        <TextBox x:Name="SearchInput" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 MinHeight="34" Padding="2,5,8,5" TextChanged="SearchInput_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索当前文件夹"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="3,0,8,0"
                                   Foreground="#7C8F88" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F3F7F5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,12">
                        <TextBlock Text="快速访问" FontSize="11" FontWeight="SemiBold" Foreground="#61766F"
                                   Margin="11,0,0,5" />
                        <Button Style="{StaticResource NavigationButton}" Content="⌂  主文件夹" Tag="Home"
                                Click="QuickLocation_Click" />
                        <Button Style="{StaticResource NavigationButton}" Content="▣  桌面" Tag="Desktop"
                                Click="QuickLocation_Click" />
                        <Button Style="{StaticResource NavigationButton}" Content="⇩  下载" Tag="Downloads"
                                Click="QuickLocation_Click" />
                        <Button Style="{StaticResource NavigationButton}" Content="▤  文档" Tag="Documents"
                                Click="QuickLocation_Click" />
                        <Button Style="{StaticResource NavigationButton}" Content="▧  图片" Tag="Pictures"
                                Click="QuickLocation_Click" />
                        <TextBlock Text="此电脑" FontSize="11" FontWeight="SemiBold" Foreground="#61766F"
                                   Margin="11,16,0,5" />
                        <StackPanel x:Name="DriveButtons" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#D8E5E0" />

            <Grid Grid.Column="2" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#FBFCFC" BorderBrush="#E1EAE6" BorderThickness="0,0,0,1" Padding="14,9">
                    <TextBlock x:Name="FolderTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
                <ListView x:Name="FileList" Grid.Row="1" BorderThickness="0" Background="White"
                          SelectionMode="Extended" PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown"
                          SelectionChanged="FileList_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Width="350">
                                <GridViewColumnHeader Tag="Name" Content="名称" Click="ColumnHeader_Click" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="165" DisplayMemberBinding="{Binding ModifiedText}">
                                <GridViewColumnHeader Tag="Modified" Content="修改日期" Click="ColumnHeader_Click" />
                            </GridViewColumn>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding TypeText}">
                                <GridViewColumnHeader Tag="Type" Content="类型" Click="ColumnHeader_Click" />
                            </GridViewColumn>
                            <GridViewColumn Width="105" DisplayMemberBinding="{Binding SizeText}">
                                <GridViewColumnHeader Tag="Size" Content="大小" Click="ColumnHeader_Click" />
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E5E0" BorderThickness="0,1,0,0">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionSummary" Text="尚未选择文件" FontWeight="SemiBold" />
                    <TextBlock Text="普通单击只选择一项；按住 Shift 单击可增加选择。"
                               FontSize="11" Foreground="#61766F" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" Padding="17,7" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Content="追加所选文件" Padding="17,7"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"
                            Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
