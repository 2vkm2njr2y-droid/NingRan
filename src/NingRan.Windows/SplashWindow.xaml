<Window x:Class="NingRan.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="260"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" Opacity="0" Loaded="Window_Loaded">
    <Border Margin="18" CornerRadius="26" Background="#FBFDFC" BorderBrush="#D7E8E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.20" Color="#17352C" />
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="凝" Width="112" FontSize="72" FontWeight="Bold" Foreground="#168565"
                       TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Text="凝然加密" Margin="0,12,0,0" FontFamily="Microsoft YaHei UI"
                       FontSize="28" FontWeight="Bold" Foreground="#17352C"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
