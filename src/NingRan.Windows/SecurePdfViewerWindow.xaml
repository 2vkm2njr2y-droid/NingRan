<Window x:Class="NingRan.Windows.SecurePdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="凝然加密 · 安全 PDF 查看" Width="1120" Height="780" MinWidth="760" MinHeight="520"
        Icon="Assets/AppIcon.ico" Background="#17221E" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#F5F9F7" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" Foreground="#17352C" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="安全查看：PDF 仅通过加密会话按需读取，不会导出普通文件。" Margin="0,4,0,0" FontSize="12" Foreground="#527065" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" ClipToBounds="True">
            <wv2:WebView2 x:Name="PdfBrowser" />
        </Border>
    </Grid>
</Window>
