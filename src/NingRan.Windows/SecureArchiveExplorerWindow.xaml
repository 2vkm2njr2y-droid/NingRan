<Window x:Class="NingRan.Windows.SecureArchiveExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="安全查看" Width="1360" Height="860" MinWidth="1040" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" ShowInTaskbar="True"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E9EEF5" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCE6F2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E9EEF5" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCE6F2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E9EEF5" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCE6F2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE4E9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="5"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F0F5FB" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DDEEE8" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ExplorerItemTemplate">
            <Grid Width="190" Height="208">
                <Grid.RowDefinitions><RowDefinition Height="138" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Width="178" Height="126" HorizontalAlignment="Center" Background="#EEF2F7" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="7,8,7,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="{Binding DetailText}" Foreground="#667085" FontSize="11" Margin="7,3,7,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ExplorerItemsPanel">
            <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" /><RowDefinition Height="52" /><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="32" Height="32" Background="#117A63" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,10,0">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="M4,7 L4,5 C4,2.8 5.8,1 8,1 C10.2,1 12,2.8 12,5 L12,7 L14,7 L14,15 L2,15 L2,7 Z M6,7 L10,7 L10,5 C10,3.9 9.1,3 8,3 C6.9,3 6,3.9 6,5 Z M8,9 C7.4,9 7,9.4 7,10 C7,10.4 7.2,10.8 7.6,11 L7.6,13 L8.4,13 L8.4,11 C8.8,10.8 9,10.4 9,10 C9,9.4 8.6,9 8,9 Z" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="安全查看" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock x:Name="ArchiveNameText" Foreground="#667085" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="关闭" Click="Close_Click" Padding="14,7" Background="#FFFFFF" BorderBrush="#DCE4E9" BorderThickness="1" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,6,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="后退" IsEnabled="False" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="前进" IsEnabled="False" />
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="向上" IsEnabled="False" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新" Click="Refresh_Click" />
            </StackPanel>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DCE4E9" BorderThickness="1" CornerRadius="12" Margin="12,0,12,0" Padding="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#667085" Margin="0,0,9,0" />
                    <TextBlock Text="此电脑" Foreground="#667085" />
                    <TextBlock Text="  ›  " Foreground="#98A2B3" />
                    <TextBlock Text="安全内容" FontWeight="SemiBold" Foreground="#344054" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged" ToolTip="搜索文件" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#667085" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="6,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CommandButton}" Click="Export_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="导出" /></StackPanel></Button>
                    <Button Style="{StaticResource CommandButton}" Click="Append_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="追加文件" /></StackPanel></Button>
                    <Button Style="{StaticResource CommandButton}" Click="Delete_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="删除" /></StackPanel></Button>
                    <Button Style="{StaticResource CommandButton}" Click="Verify_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="完整检查" /></StackPanel></Button>
                    <Button Style="{StaticResource CommandButton}" Click="Size_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="体积信息" /></StackPanel></Button>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="大图标" Foreground="#667085" VerticalAlignment="Center" Margin="10,0,12,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel>
                    <TextBlock Text="导航" Foreground="#667085" FontSize="11" Margin="7,4,0,8" />
                    <Button Tag="All" Click="NavFilter_Click" Style="{StaticResource NavButton}" Background="#DDEEE8" Foreground="#117A63"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="24" /><TextBlock Text="安全内容" FontWeight="SemiBold" /></StackPanel></Button>
                    <Button Tag="All" Click="NavFilter_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="24" /><TextBlock Text="所有文件" /></StackPanel></Button>
                    <Button Tag="Image" Click="NavFilter_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" Width="24" /><TextBlock Text="图片" /></StackPanel></Button>
                    <Button Tag="Video" Click="NavFilter_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Width="24" /><TextBlock Text="视频" /></StackPanel></Button>
                    <Button Tag="Document" Click="NavFilter_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Width="24" /><TextBlock Text="文档" /></StackPanel></Button>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="7,0,7,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="安全内容" FontSize="14" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Grid.Column="1" Foreground="#667085" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="ItemsList" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ExplorerItemTemplate}"
                             ItemsPanel="{StaticResource ExplorerItemsPanel}" MouseDoubleClick="ItemsList_MouseDoubleClick" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusText" Text="双击文件即可安全查看。" Foreground="#667085" Margin="5,8,0,0" />
        <Grid x:Name="ThumbnailHost" Width="160" Height="90" Margin="-1000,0,0,0" Opacity="0.01"
              IsHitTestVisible="False" Loaded="ThumbnailHost_Loaded">
            <vlc:VideoView x:Name="ThumbnailVideoView" />
        </Grid>
    </Grid>
</Window>
