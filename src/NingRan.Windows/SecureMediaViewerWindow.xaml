<Window x:Class="NingRan.Windows.SecureMediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="凝然安全媒体查看" Icon="Assets/AppIcon.ico"
        Width="1220" Height="820" MinWidth="900" MinHeight="580"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="安全媒体查看" FontSize="21" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E3F2EC" CornerRadius="10" Padding="11,6" VerticalAlignment="Center">
                <TextBlock Text="不保存明文" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前文件夹" FontWeight="SemiBold" FontSize="15" />
                    <ComboBox x:Name="TypeFilterCombo" Grid.Row="1" Margin="0,10,0,10" SelectionChanged="TypeFilterCombo_SelectionChanged">
                        <ComboBoxItem Content="全部媒体" Tag="all" IsSelected="True" />
                        <ComboBoxItem Content="图片" Tag="image" />
                        <ComboBoxItem Content="视频" Tag="video" />
                        <ComboBoxItem Content="音频" Tag="audio" />
                        <ComboBoxItem Content="文本" Tag="text" />
                    </ComboBox>
                    <ListBox x:Name="Playlist" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="Playlist_SelectionChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentFileText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel x:Name="PlaybackRulePanel" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="播放结束后" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,7,0" />
                            <ComboBox x:Name="PlaybackRuleCombo" Width="132" SelectedIndex="0">
                                <ComboBoxItem Content="播完停止" Tag="stop" />
                                <ComboBoxItem Content="自动下一项" Tag="next" />
                                <ComboBoxItem Content="循环当前项" Tag="one" />
                                <ComboBoxItem Content="循环整个列表" Tag="all" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Border x:Name="EmptyView" Background="#F5F9F7" CornerRadius="12" Padding="20">
                            <TextBlock x:Name="EmptyText" Text="请选择左侧文件" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="#17221E" MouseWheel="ImageScroll_MouseWheel">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ImageView" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </ScrollViewer>
                        <TextBox x:Name="TextView" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14"
                                 Background="#F8FBF9" BorderThickness="0" Padding="14" />
                        <wv2:WebView2 x:Name="MediaBrowser" Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ImageZoomPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,8,0" />
                            <Button Content="−" Click="ZoomOut_Click" Padding="8,3" MinHeight="0" />
                            <Slider x:Name="ImageZoomSlider" Width="150" Minimum="0.2" Maximum="4" Value="1" TickFrequency="0.1"
                                    Margin="8,0" ValueChanged="ImageZoomSlider_ValueChanged" />
                            <Button Content="＋" Click="ZoomIn_Click" Padding="8,3" MinHeight="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="鼠标滚到图片顶部或底部可切换上一张/下一张" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
