<Window x:Class="NingRan.Windows.DeliveryWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全交付" Width="900" Height="700" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F9F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#D8E5E0" BorderThickness="0,0,0,1">
            <Grid Margin="26,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="安全交付" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="StepTitle" Text="第 1 步，共 5 步：选择资料"
                               Foreground="#61766F" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E3F2EC" CornerRadius="12" Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StepBadge" Text="1 / 5" Foreground="#176B50" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,22">
            <Grid x:Name="SourcePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="选择要交给对方的文件和文件夹" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,13,0,12">
                    <Button Content="添加文件" Click="AddFiles_Click" Margin="0,0,8,0" />
                    <Button Content="添加文件夹" Click="AddFolder_Click" Margin="0,0,8,0" />
                    <Button Content="移除所选" Click="RemoveSource_Click" />
                </StackPanel>
                <ListBox x:Name="SourceList" Grid.Row="2" SelectionMode="Extended" />
                <TextBlock x:Name="SourceSummary" Grid.Row="3" Text="尚未选择资料。"
                           Foreground="#61766F" Margin="0,10,0,0" TextWrapping="Wrap" />
            </Grid>

            <Grid x:Name="InfoPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="填写交付信息" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="交付名称" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBox x:Name="DeliveryNameInput" Grid.Row="2" MaxLength="120" />
                <TextBlock Grid.Row="3" Text="交付说明（可不填）" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBox x:Name="DeliveryDescriptionInput" Grid.Row="4" MaxLength="4000" Height="130"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <TextBlock Text="接收对象（可不指定）" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="RecipientCombo" DisplayMemberPath="DisplayText" />
                    <TextBlock Text="只有已经完成安全码核对的联系人会出现在这里；不指定联系人时不会显示成“已确认接收方”。"
                               Foreground="#61766F" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ProtectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置保护方式" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="交付密码" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <PasswordBox x:Name="PasswordInput" />
                    <TextBlock Text="再次输入" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordInput" />
                    <TextBlock Text="建议使用至少 16 个字符、容易记住但别人猜不到的口令。"
                               Foreground="#61766F" FontSize="12" Margin="0,6,0,0" />

                    <TextBlock Text="发送者身份" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ComboBox x:Name="SigningIdentityCombo" DisplayMemberPath="DisplayText" />
                    <TextBlock Text="发送者身份密码" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <PasswordBox x:Name="SigningPasswordInput" />

                    <TextBlock Text="更多保护方式" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ComboBox x:Name="ProtectionModeCombo" SelectedIndex="0" SelectionChanged="ProtectionMode_Changed">
                        <ComboBoxItem Content="只使用交付密码（推荐）" />
                        <ComboBoxItem Content="交付密码＋密匙文件" />
                        <ComboBoxItem Content="交付密码＋物理设备" />
                        <ComboBoxItem Content="交付密码＋Windows Hello" />
                    </ComboBox>
                    <Grid x:Name="KeyFilePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyFilePathInput" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="选择密匙" Click="PickKeyFile_Click" Margin="8,0,0,0" />
                    </Grid>
                    <StackPanel x:Name="PhysicalDevicePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <ListBox x:Name="PhysicalDeviceList" SelectionMode="Multiple" DisplayMemberPath="DisplayText"
                                 MinHeight="70" MaxHeight="130" />
                        <TextBlock Text="生成时需要逐一出示所选设备；接收方打开时需使用其中一个设备。"
                                   Foreground="#A33838" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="WindowsHelloPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Button Content="登记本机 Windows Hello" Click="RegisterWindowsHello_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="WindowsHelloText" Text="只能在登记的本机和当前 Windows 账户使用；请保留交付密码作为恢复方式。" Foreground="#A33838" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="RulesPage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="设置使用规则" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="有效期" FontWeight="SemiBold" Margin="0,20,0,6" />
                    <ComboBox x:Name="ExpirationCombo" SelectedIndex="2">
                        <ComboBoxItem Content="1 天" Tag="1" />
                        <ComboBoxItem Content="7 天" Tag="7" />
                        <ComboBoxItem Content="30 天（推荐）" Tag="30" />
                        <ComboBoxItem Content="90 天" Tag="90" />
                        <ComboBoxItem Content="永久有效" Tag="0" />
                    </ComboBox>
                    <CheckBox x:Name="AllowExportCheck" IsChecked="True" Margin="0,20,0,0"
                              Content="允许接收方导出明文文件" />
                    <Border Background="#FFF6E5" BorderBrush="#E6C77E" BorderThickness="1" CornerRadius="10"
                            Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="请了解离线限制" FontWeight="SemiBold" />
                            <TextBlock Text="有效期依赖接收方电脑的本地时间。离线软件无法完全阻止手动修改系统时间。禁止导出也无法阻止截图、拍照或录屏。"
                                       TextWrapping="Wrap" Foreground="#70551A" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="ReviewPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="检查并生成" FontSize="18" FontWeight="SemiBold" />
                <TextBox x:Name="ReviewText" Grid.Row="1" Margin="0,15,0,12" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="2" Text="保存位置" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathInput" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="选择" Click="PickOutput_Click" Margin="8,0,0,0" />
                </Grid>
            </Grid>

            <Grid x:Name="ResultPage" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock Text="✓" FontSize="52" Foreground="#176B50" HorizontalAlignment="Center" />
                    <TextBlock Text="安全交付包已生成并通过自动检查" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#61766F" Margin="0,12,0,18" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="打开保存位置" Click="OpenLocation_Click" Margin="0,0,8,0" />
                        <Button Content="复制接收说明" Click="CopyInstructions_Click" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8E5E0" BorderThickness="0,1,0,0">
            <Grid Margin="26,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="上一步" Click="Back_Click" Width="100" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消" IsCancel="True" Width="90" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Content="下一步" Click="Next_Click" Width="120"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
