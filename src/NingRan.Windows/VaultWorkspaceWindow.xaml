<Window x:Class="NingRan.Windows.VaultWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NingRan.Windows"
        Title="保险箱内部浏览" Width="900" Height="650" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PageBrush}"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="程序内部安全浏览" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="HintText"
                       Text="当前内容不会建立临时磁盘。支持的文字、图片、音频和视频会直接在程序内按需读取；只有明确导出时才会产生普通文件。"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <Button x:Name="AddFilesButton" Content="添加文件" Click="AddFiles_Click" Margin="0,0,8,0" />
            <Button x:Name="AddFolderButton" Content="添加文件夹" Click="AddFolder_Click" Margin="0,0,8,0" />
            <Button x:Name="NewFolderButton" Content="新建文件夹" Click="NewFolder_Click" Margin="0,0,8,0" />
            <Button x:Name="MoveButton" Content="移动或重命名" Click="Move_Click" Margin="0,0,8,0" />
            <Button x:Name="ReplaceButton" Content="替换文件内容" Click="Replace_Click" Margin="0,0,8,0" />
            <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" Margin="0,0,8,0" />
            <Button x:Name="PreviewButton" Content="安全查看" Click="Preview_Click" Margin="0,0,8,0" />
            <Button x:Name="ExportButton" Content="导出明文…" Click="Export_Click" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <TreeView x:Name="FileTree" SelectedItemChanged="FileTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:VaultWorkspaceTreeItem}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding RelativePath}" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <TextBlock x:Name="PreviewHint" Text="选择文件后点击“安全查看”。" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBox x:Name="TextPreview" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <ScrollViewer x:Name="ImagePreviewScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="ImagePreview" Stretch="None" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="请选择要操作的内容。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消当前操作" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
