<Window x:Class="NingRan.Windows.ExportArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="570" Height="390" MinWidth="520" MinHeight="360"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="18" CornerRadius="20" Background="#FCFEFD" BorderBrush="#CFE2DA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.22" Color="#17352C" />
        </Border.Effect>
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#E5F4EE">
                    <Image Source="Assets/AppIcon.png" Width="30" Height="30" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="导出内容" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="请选择本次导出的内容类型" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,22,0,12">
                <RadioButton x:Name="EncryptedPackageOption" IsChecked="True" GroupName="ExportType" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock x:Name="EncryptedPackageTitle" Text="导出加密包（.nrenc）" FontWeight="SemiBold" />
                        <TextBlock x:Name="EncryptedPackageDescription" Text="可复制到任意磁盘或发送给他人；内容继续保持加密，不会生成明文。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PlaintextOption" GroupName="ExportType">
                    <StackPanel>
                        <TextBlock x:Name="PlaintextTitle" Text="导出明文" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlaintextDescription" Text="还原普通文件或文件夹。导出后请自行保护该位置的明文内容。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" MinWidth="92" Margin="0,0,8,0" />
                <Button x:Name="ContinueButton" Content="继续" Click="ContinueButton_Click" Style="{StaticResource PrimaryButton}" MinWidth="92" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
