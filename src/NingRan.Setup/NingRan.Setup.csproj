<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NingRan.Setup.Core\NingRan.Setup.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\NingRan.Windows\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NingRanSetup</AssemblyName>
    <RootNamespace>NingRan.Setup.Windows</RootNamespace>
    <Version>10.0.3</Version>
    <AssemblyVersion>10.0.3.0</AssemblyVersion>
    <FileVersion>10.0.3.0</FileVersion>
    <InformationalVersion>10.0.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Keep single-file as a project property so NuGet's locked restore sees
         the ILLink tool dependency consistently instead of receiving it only
         as a one-off global property during the final publish. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SetupFlavor)' == 'MediaPlayer'">
    <DefineConstants>$(DefineConstants);NINGRAN_MEDIA_PLAYER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\NingRan.Windows\Assets\AppIcon.png" Link="Assets\AppIcon.png" />
    <Resource Include="..\NingRan.Windows\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
    <EmbeddedResource Include="$(InstallerPayload)"
                      LogicalName="NingRan.Setup.Payload.zip"
                      Condition="'$(InstallerPayload)' != '' And Exists('$(InstallerPayload)')" />
  </ItemGroup>

</Project>
