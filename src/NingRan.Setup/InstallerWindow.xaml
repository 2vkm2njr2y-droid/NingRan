<Window x:Class="NingRan.Setup.Windows.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凝然加密安装程序" Width="980" Height="660" MinWidth="900" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Background="Transparent">
    <Border x:Name="WindowFrame" Margin="12" CornerRadius="22" Background="{StaticResource CardBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.2" Color="#245B49" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#168565" CornerRadius="22,0,0,22">
                <Grid Margin="34,34,30,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="74" Height="74" CornerRadius="18" Background="#E9FFF7"
                                HorizontalAlignment="Left">
                            <Image Source="Assets/AppIcon.png" Width="56" Height="56" />
                        </Border>
                        <TextBlock Text="凝然加密" Foreground="White" FontSize="27" FontWeight="SemiBold"
                                   Margin="0,20,0,4" />
                        <TextBlock x:Name="LeftModeText" Text="安全离线安装" Foreground="#CBEBDD" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StepOneText" Text="01  阅读说明" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <TextBlock x:Name="StepTwoText" Text="02  安装选项" Foreground="#A9D7C7"
                                   FontSize="15" Margin="0,0,0,20" />
                        <TextBlock x:Name="StepThreeText" Text="03  安装完成" Foreground="#A9D7C7"
                                   FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="VersionText" Foreground="#CBEBDD" FontSize="12" />
                        <TextBlock Text="无需管理员权限" Foreground="#CBEBDD" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FBFA" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="WindowCaption" Text="凝然加密安装程序" VerticalAlignment="Center"
                                   Margin="26,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        <Button HorizontalAlignment="Right" Width="52" Height="52" MinHeight="0" Padding="0"
                                Content="×" FontSize="22" BorderThickness="0" Background="Transparent"
                                Click="CloseButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="42,28,42,18">
                    <Grid x:Name="WelcomePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="欢迎安装凝然加密" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="完整离线安装，不会上传文件、身份、密码或密匙。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,20" />
                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="安装须知与隐私说明" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                                <TextBlock TextWrapping="Wrap" LineHeight="23" Foreground="{StaticResource MutedBrush}">
                                    本程序按当前状态提供，用于在本机保护文件。请自行妥善保存密码、身份备份、密匙文件和授权设备；遗失开锁条件后，程序无法代为恢复内容。
                                    <LineBreak /><LineBreak />
                                    程序的加密、解密和身份管理均在本机完成，不主动连接网络，也不收集或上传用户文件及使用记录。
                                    <LineBreak /><LineBreak />
                                    安装和升级默认保留凝然加密的身份、可信联系人、设备登记及设置；卸载时只有经过用户明确勾选并再次确认，才会删除这些个人数据。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="AcceptNoticeCheck" Grid.Row="3"
                                  Content="我已阅读并理解以上安装须知与隐私说明"
                                  Margin="2,18,0,0" Checked="AcceptNoticeChanged" Unchecked="AcceptNoticeChanged" />
                    </Grid>

                    <Grid x:Name="OptionsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="OptionsTitle" Text="选择安装方式" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="程序固定安装在当前用户的安全位置；身份和设置独立保存，升级不会覆盖。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,22" />
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathInput" IsReadOnly="True" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="22,17" Margin="0,20,0,0">
                            <StackPanel>
                                <CheckBox x:Name="DesktopShortcutCheck" IsChecked="True" Content="创建桌面快捷方式" Margin="0,0,0,14" />
                                <CheckBox x:Name="StartMenuShortcutCheck" IsChecked="True" Content="创建开始菜单快捷方式" Margin="0,0,0,14" />
                                <CheckBox x:Name="FileAssociationsCheck" IsChecked="True"
                                          Content="关联加密文件和身份信息（.nrenc、.nrid、.nrpub）" />
                                <TextBlock Text="不关联普通密匙文件和 .nrkey；仍可在程序内手动选择。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="25,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="82" Height="82" CornerRadius="41" Background="#E4F4EE"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="39"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ProgressTitle" Text="正在安装凝然加密" FontSize="25" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,22,0,8" />
                            <TextBlock x:Name="ProgressMessage" Text="正在准备…" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100"
                                         Value="0" Margin="38,26,38,0" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="UninstallPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="卸载凝然加密" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="默认只删除程序，身份、可信联系人、设备登记和设置都会保留。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,22" />
                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="程序位置" FontWeight="SemiBold" />
                                <TextBlock x:Name="UninstallPathText" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Background="#FFF9EB" BorderBrush="#ECD9A7"
                                BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox x:Name="DeleteUserDataCheck"
                                          Content="同时删除本机保存的全部身份、联系人、设备登记和设置"
                                          FontWeight="SemiBold" />
                                <TextBlock x:Name="UserDataInventoryText" Text="正在统计个人数据…"
                                           TextWrapping="Wrap" Foreground="#7A6540" Margin="25,9,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="FinishPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="92" Height="92" CornerRadius="46" Background="#DDF3EA"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="✓" Foreground="{StaticResource PrimaryBrush}" FontSize="45"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="FinishTitle" Text="凝然加密安装完成" FontSize="27" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,24,0,8" />
                            <TextBlock x:Name="FinishMessage" Text="现在可以开始保护文件。"
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                            <CheckBox x:Name="RunAfterInstallCheck" IsChecked="True" Content="立即运行凝然加密"
                                      HorizontalAlignment="Center" Margin="0,22,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="28,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BackButton" Content="上一步" Click="BackButton_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" Margin="0,0,10,0" />
                            <Button x:Name="NextButton" Content="继续" Style="{StaticResource PrimaryButton}"
                                    Click="NextButton_Click" IsEnabled="False" MinWidth="105" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
