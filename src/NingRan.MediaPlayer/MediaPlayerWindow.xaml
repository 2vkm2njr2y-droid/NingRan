<Window x:Class="NingRan.MediaPlayer.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="凝然安全播放器" Width="1180" Height="760" MinWidth="760" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" Background="#111714"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform><ScaleTransform x:Name="WindowScale" ScaleX="0.985" ScaleY="0.985" /></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17221E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Margin="16,0" VerticalAlignment="Center" Foreground="#F3F7F5"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Width="42" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Content="□" Width="42" Click="Maximize_Click" />
                    <Button Content="×" Width="42" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#0B0D0C">
            <wv2:WebView2 x:Name="MediaBrowser" />
        </Border>
    </Grid>
</Window>
