<Window x:Class="NingRan.MediaPlayer.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="凝然媒体播放器" Icon="Assets/AppIcon.ico"
        Width="1180" Height="760" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#0B0D0C"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E8F4EE" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3564E0BD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#70168565" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17221E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="凝然媒体播放器" Foreground="#F2FAF6" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="15,0,8,0" />
                <TextBlock x:Name="TitleText" Grid.Column="1" TextTrimming="CharacterEllipsis" Foreground="#B6C9BF"
                           VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2014;" Width="42" Style="{StaticResource ToolButton}" ToolTip="最小化" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Width="42" Style="{StaticResource ToolButton}" ToolTip="最大化" Click="Maximize_Click" />
                    <Button Content="&#x00D7;" Width="42" Style="{StaticResource ToolButton}" ToolTip="关闭" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#090B0A" ClipToBounds="True" MouseLeftButtonDown="MediaArea_MouseLeftButtonDown">
            <vlc:VideoView x:Name="MediaView" />
            <Border x:Name="StatusPanel" Background="#D90B0D0C" Padding="18" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="StatusText" Foreground="#E8F4EE" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#EF17221E" Padding="18,9,18,11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#E9F7F0" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0"
                            VerticalAlignment="Center" PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#E9F7F0" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentFileText" Foreground="#F2FAF6" FontWeight="SemiBold" MaxWidth="310"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousButton" Content="&#x23EE;" Style="{StaticResource ToolButton}" ToolTip="上一项" Click="Previous_Click" />
                        <Button Content="&#x21B6; 10" Style="{StaticResource ToolButton}" ToolTip="后退 10 秒" Click="BackTen_Click" />
                        <Border Width="42" Height="42" Background="#168565" BorderBrush="#64E0BD" BorderThickness="2" CornerRadius="21" Margin="5,0">
                            <Button x:Name="PlayButton" Content="&#x25B6;" Style="{StaticResource ToolButton}" FontSize="18" Padding="0"
                                    ToolTip="播放或暂停" Click="PlayPause_Click" />
                        </Border>
                        <Button Content="30 &#x21B7;" Style="{StaticResource ToolButton}" ToolTip="前进 30 秒" Click="ForwardThirty_Click" />
                        <Button x:Name="NextButton" Content="&#x23ED;" Style="{StaticResource ToolButton}" ToolTip="下一项" Click="Next_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Content="&#x1F4C2;" Style="{StaticResource ToolButton}" ToolTip="打开媒体文件" Click="Open_Click" />
                        <TextBlock Text="音量" Foreground="#B6C9BF" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <Slider x:Name="VolumeSlider" Width="76" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <Button Content="&#x26F6;" Style="{StaticResource ToolButton}" ToolTip="全屏" FontSize="17" Click="Fullscreen_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
